{
  "name": "@cassius0924/agystatusline",
  "version": "0.8.3",
  "description": "Configurable status line for the Antigravity CLI (agy): widgets, colours, powerline blocks and multi-line layouts in settings.json.",
  "keywords": [
    "agy",
    "antigravity",
    "antigravity-cli",
    "statusline",
    "status-line",
    "terminal",
    "cli",
    "gemini",
    "powerline",
    "tui"
  ],
  "type": "module",
  "main": "src/render.js",
  "exports": {
    ".": "./src/render.js",
    "./presets": "./src/presets.js",
    "./package.json": "./package.json"
  },
  "bin": {
    "agystatusline": "bin/agystatusline.js"
  },
  "files": [
    "bin/",
    "src/",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test",
    "demo": "node bin/agystatusline.js --demo"
  },
  "engines": {
    "node": ">=18"
  },
